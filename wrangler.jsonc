{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coffee-storefront-phase1",
  "compatibility_date": "2026-10-04",
  "main": "./worker/router.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
