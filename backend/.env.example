PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=standard_dose
DB_SSL=false
DB_SYNCHRONIZE=false

# Vendure auth
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-me
COOKIE_SECRET=replace-with-a-long-random-secret

# Comma-separated storefront origins allowed to call the Shop API
STOREFRONT_ORIGINS=http://localhost:5173,https://coffee.mrkyleoreilly.workers.dev

# Assets
ASSET_UPLOAD_DIR=./static/assets
# ASSET_URL_PREFIX=https://your-vendure-host.example/assets/

# Run committed migrations automatically at server startup
RUN_MIGRATIONS=true
